{
  "name": "nexaheart",
  "author": {
    "name": "Diamond Rubinny",
    "url": "https://github.com/diamondrubinny"
  },
  "private": true,
  "description": "Open-source, privacy-first dating platform anyone can self-host.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && node scripts/check-credit.mjs",
    "check:credit": "node scripts/check-credit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "sbom": "npx --yes @cyclonedx/cdxgen@12.8.5 -t js --no-recurse -o sbom.cdx.json ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diamondrubinny/Dateos.git"
  },
  "homepage": "https://github.com/diamondrubinny/Dateos"
}
