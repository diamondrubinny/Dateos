# NexaHeart public site. Set DOMAIN (e.g. example.org) in .env; DNS for DOMAIN, admin.DOMAIN and
# api.DOMAIN must point at this server. Caddy obtains and renews the certificates itself.
# To receive certificate notices, add a global block at the top:  { email you@example.org }

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

(spa) {
	encode zstd gzip
	try_files {path} /index.html
	file_server
	@html path / /index.html
	header @html Cache-Control "no-store"
	@assets path /_expo/* /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

# The member app (web/PWA). react-native-web injects its styles at runtime, hence
# 'unsafe-inline' for styles only; scripts stay restricted to this origin, plus the hosts in
# CSP_EXTRA_HOSTS for a CAPTCHA or analytics set up in the dashboard (phase 24).
{$DOMAIN} {
	import security
	root * /srv/app
	# Phase 57: the web app manifest, made by the API from the community's branding, served here
	# so its paths are the app's own. In its own handle: the app's try_files would turn it into
	# index.html otherwise.
	handle /manifest.webmanifest {
		rewrite * /v1/instance/manifest.webmanifest
		reverse_proxy api:4000
	}
	handle {
		import spa
	}
	# The service worker is checked on every visit, so a fixed build reaches people.
	header /sw.js Cache-Control "no-cache"
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' {$CSP_EXTRA_HOSTS}; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://api.{$DOMAIN}; media-src 'self' blob: https://api.{$DOMAIN}; connect-src 'self' https://api.{$DOMAIN} wss://api.{$DOMAIN} https://{$RTC_DOMAIN:rtc.localhost} wss://{$RTC_DOMAIN:rtc.localhost} {$CSP_EXTRA_HOSTS}; frame-src {$CSP_EXTRA_HOSTS:'none'}; font-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self)"
	}
}

# Moderation dashboard. Consider restricting it further (VPN or the allowlist below).
admin.{$DOMAIN} {
	import security
	# @outside not remote_ip 203.0.113.0/24
	# respond @outside 403
	root * /srv/admin
	encode zstd gzip
	try_files {path} /index.html
	file_server
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src blob:; connect-src 'self' https://api.{$DOMAIN}; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cache-Control "no-store"
	}
}

# API (REST + WebSocket). The API trusts the X-Forwarded-For set here (TRUST_PROXY=true).
api.{$DOMAIN} {
	import security
	request_body {
		max_size 12MB
	}
	reverse_proxy api:4000

	# Phase 55: while the API restarts or installs an update, Caddy can't reach it. Instead of an
	# empty 502, answer like the API would: 503, SERVER_RESTARTING, try again in 30 seconds. The
	# app and the dashboard then say "can't be reached right now" and carry on by themselves. CORS
	# only for the app and the dashboard (the origins the API itself allows), so browsers can read it.
	handle_errors 502 503 504 {
		@ours expression `{http.request.header.Origin} in ["https://{$DOMAIN}", "https://admin.{$DOMAIN}"]`
		header @ours {
			Access-Control-Allow-Origin {http.request.header.Origin}
			Access-Control-Allow-Credentials true
			Vary Origin
		}
		header {
			Content-Type application/json
			Retry-After 30
			Cache-Control no-store
		}
		respond `{"error":{"code":"SERVER_RESTARTING","message":"The server is restarting or installing an update. Try again in a minute."}}` 503
	}
}

# Video dates (docker compose --profile video): LiveKit's signalling over WSS. Audio and video use
# LiveKit's own ports (TCP 7881, UDP 7882), not this proxy. RTC_DOMAIN defaults to rtc.localhost,
# which needs no public certificate, so nothing happens here until video dates are set up.
{$RTC_DOMAIN:rtc.localhost} {
	import security
	reverse_proxy livekit:7880
}
