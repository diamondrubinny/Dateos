# Copy to .env (or run ./install.sh, which also generates strong secrets).
# Never commit .env. Values marked CHANGE_ME must be replaced.

# --- API ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (web/PWA, admin).
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5174
# The web app's public address: links in emails and the passkey domain (default: the first CORS origin).
# PUBLIC_APP_URL=https://app.example.org
# true only when the API runs behind a reverse proxy you control.
TRUST_PROXY=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=65536
# Public URL of the API (used in sign-in emails). Must be https in production.
PUBLIC_API_URL=http://localhost:4000
# Applies database migrations when the API starts (disable for multiple replicas).
MIGRATE_ON_START=true

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=nexaheart
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nexaheart
DATABASE_URL=postgres://nexaheart:CHANGE_ME@localhost:5432/nexaheart

# --- Redis -------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# --- Object storage (S3-compatible: SeaweedFS by default) --------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_QUARANTINE=nexaheart-quarantine
S3_BUCKET_MEDIA=nexaheart-media

# --- Public site (docker compose --profile app) ----------------------------
# Your domain: the app is served on DOMAIN, the dashboard on admin.DOMAIN, the API on api.DOMAIN.
# ./install.sh --domain example.org fills this in (and the API URL/CORS settings below).
DOMAIN=

# --- Auth ----------------------------------------------------------------
# At least 32 random bytes. Rotating it signs every user out.
AUTH_SECRET=CHANGE_ME
# One-time token to claim this instance in the dashboard (install.sh generates it). The first
# person who enters it becomes admin; afterwards it is useless. Empty = server CLI only.
SETUP_TOKEN=
# Deep-link scheme of the native app.
APP_SCHEME=nexaheart
# Optional social sign-in (leave empty to disable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Email (magic-link login; Mailpit catches mail in development) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NexaHeart <no-reply@localhost>"

# --- Malware scanning (worker) -----------------------------------------
# clamav (recommended; start compose with --profile full) | disabled ("Lite mode", not scanned)
MALWARE_SCAN=clamav

# --- Push notifications (optional) ------------------------------------------
# `expo` sends content-free notifications ("You have a new message") through Expo's push
# service, Apple and Google. Members opt in per device. Requires your own EAS build of the app.
# Leave both commented to turn push on (and set the token) in the dashboard's Integrations page.
# PUSH_PROVIDER=expo
# Optional access token from your Expo account (enhanced push security).
# EXPO_ACCESS_TOKEN=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
WORKER_CONCURRENCY=2

# --- Instance branding ----------------------------------------------------
INSTANCE_NAME=NexaHeart
INSTANCE_TAGLINE=Free, open-source dating. Built for real connections.
INSTANCE_PRIMARY_COLOR="#7C3AED"
INSTANCE_LOCALES=he,en,ar,ru
INSTANCE_DEFAULT_LOCALE=he
# Where the app's "Open source" link points. If you change the code, set it to where your
# version's source is published (AGPL-3.0 section 13). Default: the upstream repository.
# SOURCE_CODE_URL=https://github.com/your-name/your-fork
# Optional "Support this project" link shown on the web app (e.g. GitHub Sponsors).
SPONSOR_URL=https://github.com/sponsors/diamondrubinny
# Bump these when the documents change; users are asked to accept again.
TERMS_VERSION=2026-10
PRIVACY_VERSION=2026-10

# --- Privacy and retention (see docs/PRIVACY.md) -----------------------------
# Delete accounts with no sign-in for this many months, after a 30-day email warning.
# 0 = never (default). Choose a value with legal advice for your community ⚖️
INACTIVE_ACCOUNT_DELETE_MONTHS=0

# --- Video dates (optional, docker compose --profile video) -----------------
# ./install.sh --domain example.org --video fills these in (see docs/SELF_HOSTING.md). Calls stay
# off until an admin turns them on in the dashboard. LIVEKIT_URL empty = no video dates.
LIVEKIT_URL=
RTC_DOMAIN=
# Shared by the API, the worker and LiveKit (infra/data/livekit/livekit.yaml); install.sh generates them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI (optional, runs on this server) -----------------------------------
# Profile embeddings for matching: hashing (offline, default) | ollama (local semantic model)
EMBEDDINGS_PROVIDER=hashing
# Text AI for icebreakers and bio drafts: template (no AI, default) | ollama (on this server) |
# openai (any OpenAI-compatible endpoint). See docs/AI.md. Leave it commented to choose the model
# in the dashboard's Integrations page instead (a value here locks that card).
# ICEBREAKERS_PROVIDER=template
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=paraphrase-multilingual
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
# For ICEBREAKERS_PROVIDER=openai, e.g. vLLM/llama.cpp (OPENAI_EXTERNAL=false) or a cloud
# service (OPENAI_EXTERNAL=true: only used for members who opted in to external AI).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EXTERNAL=true

# --- Integrations (phase 24, see docs/INTEGRATIONS.md) ----------------------
# Encrypts the secrets saved in the dashboard's Integrations page (32 random bytes, hex):
#   openssl rand -hex 32       (install.sh generates it). Without it the page is read-only.
INTEGRATIONS_KEY=
# Let integrations reach hosts on this server's own network (Ollama, a self-hosted Matomo).
INTEGRATIONS_ALLOW_PRIVATE=false
# The dashboard's address for links in team alerts (default: admin.<your domain>).
PUBLIC_ADMIN_URL=
# Hosts the web app may load scripts from (CAPTCHA, analytics). The dashboard shows what to add.
CSP_EXTRA_HOSTS=
# Any of these set here locks that card in the dashboard (environment variables always win):
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# ANALYTICS_PROVIDER=plausible
# ANALYTICS_URL=
# ANALYTICS_SITE_ID=
