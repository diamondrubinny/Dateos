{
  "name": "@dateos/worker",
  "author": "Diamond Rubinny",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "reembed": "node --env-file-if-exists=../../.env dist/reembed.js"
  },
  "dependencies": {
    "@dateos/ai": "workspace:*",
    "@dateos/db": "workspace:*",
    "@dateos/shared": "workspace:*",
    "@dateos/storage": "workspace:*",
    "bullmq": "6.3.19",
    "drizzle-orm": "0.45.4",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
