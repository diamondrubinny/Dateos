{
  "expo": {
    "name": "NexaHeart",
    "slug": "nexaheart",
    "scheme": "nexaheart",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nexaheart.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos for your dating profile.",
        "NSCameraUsageDescription": "Take a photo for your dating profile."
      }
    },
    "android": {
      "package": "org.nexaheart.app",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "NexaHeart",
      "shortName": "NexaHeart",
      "description": "Free, open-source dating. Built for real connections.",
      "themeColor": "#7C3AED",
      "backgroundColor": "#FFFFFF",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["he", "en", "ar", "ru"],
            "android": ["he", "en", "ar", "ru"]
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your dating profile.",
          "cameraPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NexaHeart uses your approximate location (about 1 km) to show people nearby."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NexaHeart uses the microphone only while you record a voice message."
        }
      ],
      ["expo-notifications", {}],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
