{
  "name": "@dateos/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run --no-file-parallelism test/integration"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.12",
    "@dateos/ai": "workspace:*",
    "@dateos/db": "workspace:*",
    "@dateos/shared": "workspace:*",
    "@dateos/storage": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "better-auth": "1.7.12",
    "bullmq": "6.3.19",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
