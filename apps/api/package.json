  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run --no-file-parallelism test/integration",
    "staff": "tsx --env-file-if-exists=../../.env src/cli/staff.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@nexaheart/ai": "workspace:*",
    "@nexaheart/db": "workspace:*",
    "@nexaheart/shared": "workspace:*",
    "@nexaheart/storage": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "better-auth": "1.7.12",
    "bullmq": "6.3.19",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "10.1.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
